# ===== Copy sang .env và chỉnh sửa =====

# Database: mặc định SQLite (zero-config). Đổi sang Postgres/TimescaleDB cho production:
# DATABASE_URL=postgresql+psycopg2://stock:stock@localhost:5432/stock
DATABASE_URL=sqlite:///./stock.db

# Nguồn dữ liệu: "demo" (synthetic, chạy offline) hoặc "vnstock" (dữ liệu thật, cần cài vnstock)
DATA_SOURCE=demo
VNSTOCK_SOURCE=VCI

# Telegram (để trống = tắt gửi, chỉ log ra console)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# LLM cho tóm tắt tin tức/BCTC (để trống = dùng fallback keyword-sentiment)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# Ngưỡng cảnh báo
ALERT_MIN_SCORE=75
ALERT_VOLUME_ZSCORE=2.0

# Link dashboard nhúng vào tin nhắn Telegram
DASHBOARD_BASE_URL=http://localhost:8000

# Redis cho Celery (production)
REDIS_URL=redis://localhost:6379/0
